# ===== Application =====
APP_ENV=development
APP_NAME=night-diary-v2

# ===== Data directory =====
# Override default (Windows: %APPDATA%/night-diary, macOS/Linux: ~/.local/share/night-diary)
# DATA_DIR=D:/my_data/night-diary

# ===== Port =====
# PORT=8000

# ===== Security =====
# Fernet key for encrypting LLM API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_KEY_SECRET=

# JWT authentication (multi-user web mode)
# In development: leave empty to auto-generate via secrets.key (reuses MODEL_KEY_SECRET resolution).
# In production: MUST be set to a strong random string (>= 32 chars).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS: comma-separated additional origins (loopback is always allowed)
# Example: CORS_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ORIGINS=

# ===== LLM defaults (can be overridden per provider in-app) =====
# These apply when no model is saved in Settings. Settings UI takes precedence.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== Embedding / Rerank (Qwen DashScope cloud-first; no local model download) =====
# Embedding uses OpenAI-compatible /embeddings.
# Rerank uses Cohere-compatible /reranks (note: different path prefix than embedding).
# Leave EMBEDDING_API_KEY empty to fall back to local BGE / CrossEncoder ([eval] extra).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
# Optional override; empty reuses EMBEDDING_API_KEY for the same DashScope account.
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank

# ===== V3 P0: Streaming output (default: false) =====
# When true, scene-2 conversation uses streaming SSE; when false, falls back
# to the synchronous V2 full-response path.
STREAMING_ENABLED=false

# ── MCP 工具（可选）────────────────────────────────────────────
# HTTP 端点（streamable HTTP 或 SSE）。格式: 别名:URL,别名:URL。
# URL 以 /mcp 结尾走 streamable HTTP（多客户端安全），否则走 SSE（单客户端）。
# docker compose --profile mcp 部署时用服务名：
# MCP_ENDPOINTS=tavily:http://mcp-tavily:9202/mcp
MCP_ENDPOINTS=
# stdio 子进程。格式: 别名:命令 参数 环境键=值（不支持带空格的路径）。
# 官方 fetch server 已打进后端镜像（免 key、无网关桥接），按需显式启用：
# MCP_STDIOS=fetch:python -m mcp_server_fetch
MCP_STDIOS=
