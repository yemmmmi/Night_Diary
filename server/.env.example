# ===== Application =====
APP_ENV=development
APP_NAME=night-diary-v2

# ===== Data directory =====
# Override default (Windows: %APPDATA%/night-diary, macOS/Linux: ~/.local/share/night-diary)
# DATA_DIR=D:/my_data/night-diary

# ===== Port =====
# PORT=8000

# ===== Security =====
# Fernet key for encrypting LLM API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_KEY_SECRET=

# JWT authentication (multi-user web mode)
# In development: leave empty to auto-generate via secrets.key (reuses MODEL_KEY_SECRET resolution).
# In production: MUST be set to a strong random string (>= 32 chars).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS: comma-separated additional origins (loopback is always allowed)
# Example: CORS_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ORIGINS=

# ===== LLM defaults (can be overridden per provider in-app) =====
# These apply when no model is saved in Settings. Settings UI takes precedence.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
