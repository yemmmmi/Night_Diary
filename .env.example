# Database
MYSQL_ROOT_PASSWORD=nightdiary_root
MYSQL_DATABASE=night_diary
MYSQL_USER=nightdiary
MYSQL_PASSWORD=nightdiary_pass

# Security (MUST change in production)
JWT_SECRET_KEY=change-me-in-production-min-32-chars
MODEL_KEY_SECRET=change-me-model-key-min-16c

# LLM Configuration
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Optional: Override database (default: MySQL in Docker, SQLite local)
DATABASE_URL=mysql+pymysql://nightdiary:nightdiary_pass@localhost:3306/night_diary?charset=utf8mb4
# REDIS_URL=redis://localhost:6379/0
